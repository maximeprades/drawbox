// Copy to wifi_credentials.h and fill in. The real file is gitignored —
// never commit it (it holds your WiFi password and a DrawBox device token).
#pragma once

#define WIFI_SSID "your-2.4ghz-network"
#define WIFI_PASSWORD "your-password"

// The DrawBox dashboard server (the Pi).
#define DRAWBOX_HOST "drawbox.local"
#define DRAWBOX_PORT 5000

// Paired-device token. Mint one on the Pi:
//   press the button, say "authorize", then redeem the spoken/printed code:
//   curl -X POST http://drawbox.local:5000/api/pair \
//        -H 'Content-Type: application/json' \
//        -d '{"code":"123456","name":"ESP32 voice button"}'
#define DRAWBOX_TOKEN "paste-token-here"
