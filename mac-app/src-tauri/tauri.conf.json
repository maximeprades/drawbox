{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DrawBox",
  "version": "0.1.0",
  "identifier": "com.maximeprades.drawbox",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DrawBox",
        "width": 1280,
        "height": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"]
  }
}
